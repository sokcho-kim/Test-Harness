#!/bin/bash
#
# pre-commit hook: 시크릿/API 키 유출 방지
# 커밋 전 스테이징된 파일에서 시크릿 패턴을 검사합니다.
#

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 검사할 시크릿 패턴 목록
SECRET_PATTERNS=(
  # Google API Key
  'AIza[0-9A-Za-z_-]{35}'
  # AWS
  'AKIA[0-9A-Z]{16}'
  'aws[_-]?(secret|access)[_-]?key'
  # Generic secrets
  '["\x27]?[a-zA-Z_]*(?:SECRET|PASSWORD|PASSWD|TOKEN|PRIVATE[_-]?KEY)["\x27]?\s*[:=]\s*["\x27][^\s"'\'']{8,}'
  # OpenAI
  'sk-[a-zA-Z0-9]{20,}'
  # Anthropic
  'sk-ant-[a-zA-Z0-9_-]{20,}'
  # Together AI
  'tgp_v[0-9]_[a-zA-Z0-9]{20,}'
  # GitHub Token
  'gh[pousr]_[A-Za-z0-9_]{36,}'
  # Slack Token
  'xox[baprs]-[0-9A-Za-z-]{10,}'
  # Generic high-entropy strings assigned to key-like variables
  '["\x27]?[a-zA-Z_]*(api[_-]?key|apikey)["\x27]?\s*[:=]\s*["\x27][A-Za-z0-9_-]{20,}'
)

# .env 파일 커밋 차단
BLOCKED_FILES=(
  '.env'
  '.env.local'
  '.env.production'
  '.env.staging'
  'credentials.json'
  'service-account*.json'
  '*.pem'
  '*.key'
)

FOUND_SECRETS=0

# 1) 차단 파일 검사
for blocked in "${BLOCKED_FILES[@]}"; do
  matched_files=$(git diff --cached --name-only --diff-filter=ACM | grep -iE "(^|/)${blocked}$" 2>/dev/null)
  if [ -n "$matched_files" ]; then
    echo -e "${RED}[SECRET-SCAN] 차단된 파일이 커밋에 포함되어 있습니다:${NC}"
    echo "$matched_files"
    FOUND_SECRETS=1
  fi
done

# 2) 스테이징된 파일 내용에서 시크릿 패턴 검사
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '\.(png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|svg|lock)$')

if [ -n "$STAGED_FILES" ]; then
  for pattern in "${SECRET_PATTERNS[@]}"; do
    matches=$(git diff --cached -U0 | grep -P -i "$pattern" 2>/dev/null | head -5)
    if [ -n "$matches" ]; then
      echo -e "${RED}[SECRET-SCAN] 시크릿 패턴 감지됨:${NC}"
      echo -e "${YELLOW}패턴: $pattern${NC}"
      echo "$matches" | head -3
      echo ""
      FOUND_SECRETS=1
    fi
  done
fi

if [ "$FOUND_SECRETS" -ne 0 ]; then
  echo ""
  echo -e "${RED}========================================${NC}"
  echo -e "${RED} 시크릿이 감지되어 커밋이 차단되었습니다!${NC}"
  echo -e "${RED} 해당 내용을 제거한 후 다시 시도하세요.${NC}"
  echo -e "${RED}========================================${NC}"
  echo ""
  echo -e "무시하려면: ${YELLOW}git commit --no-verify${NC}"
  exit 1
fi

echo -e "[SECRET-SCAN] 시크릿 검사 통과 ✓"
exit 0
